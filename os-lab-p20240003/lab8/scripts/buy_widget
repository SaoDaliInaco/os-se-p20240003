#!/bin/bash

NAME=$1
QTY=$2

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
inventory_file="$script_dir/inventory.txt"
sales_log="$script_dir/sales.log"
lock_file="$script_dir/inventory.lock"

(
    flock -x 200

    # read inventory
    current=$(cat "$inventory_file")

    # validate availability
    if [ "$current" -lt "$QTY" ]; then
        echo "Transaction Failed: Not enough inventory!" >&2
        exit 1
    fi

    # write new inventory
    new=$((current - QTY))
    echo "$new" > "$inventory_file"

    # append sales log
    echo "$(date +%T) $NAME bought $QTY, inventory now $new" >> "$sales_log"

    echo "Purchase successful!"

) 200> "$lock_file"
